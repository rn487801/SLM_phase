   RowBox[{
    RowBox[{"Cos", "[", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"ArcTan", "[", 
        RowBox[{
         RowBox[{"Re", "[", "W1", "]"}], ",", 
         RowBox[{"Im", "[", "W1", "]"}]}], "]"}], "+", 
       RowBox[{"ArcTan", "[", 
        RowBox[{
         RowBox[{"Re", "[", "Ep", "]"}], ",", 
         RowBox[{"Im", "[", "Ep", "]"}]}], "]"}]}], ")"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "a"}], ",", "a"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", 
      RowBox[{"-", "a"}], ",", "a"}], "}"}], ",", 
    RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
    RowBox[{"PlotPoints", "\[Rule]", "250"}], ",", 
