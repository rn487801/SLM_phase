Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"k", "=", "750000"}], ";", 
   RowBox[{"\[Theta]", "=", 
    RowBox[{"1", 
     FractionBox["\[Pi]", "3"]}]}], ";", 
   RowBox[{"\[Theta]1", "=", 
    RowBox[{"2", 
     FractionBox["\[Pi]", "2"]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Ep", "=", 
   RowBox[{"Exp", "[", 
    RowBox[{"\[ImaginaryI]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"k", " ", "z", "*", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"k", " ", "x", "*", 
           RowBox[{"Cos", "[", "\[Theta]1", "]"}]}], "+", 
          RowBox[{"k", " ", "y", "*", 
