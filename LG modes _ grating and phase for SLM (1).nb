Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"k", "=", "750000"}], ";", 
   RowBox[{"\[Theta]", "=", 
    RowBox[{"1", 
     FractionBox["\[Pi]", "3"]}]}], ";", 
   RowBox[{"\[Theta]1", "=", 
    FractionBox["\[Pi]", "2"]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Ep", "=", 
   RowBox[{"Exp", "[", 
    RowBox[{"\[ImaginaryI]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"k", " ", "z", "*", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"k", " ", "x", "*", 
           RowBox[{"Cos", "[", "\[Theta]1", "]"}]}], "+", 
          RowBox[{"k", " ", "y", "*", 
           RowBox[{"Sin", "[", "\[Theta]1", "]"}]}]}], ")"}], "*", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ")"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"z", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Int", "=", 
  RowBox[{"DensityPlot", "[", 
   RowBox[{
    RowBox[{"Cos", "[", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"ArcTan", "[", 
        RowBox[{
         RowBox[{"Re", "[", "W1", "]"}], ",", 
         RowBox[{"Im", "[", "W1", "]"}]}], "]"}], "+", 
       RowBox[{"ArcTan", "[", 
        RowBox[{
         RowBox[{"Re", "[", "Ep", "]"}], ",", 
         RowBox[{"Im", "[", "Ep", "]"}]}], "]"}]}], ")"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "a"}], ",", "a"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", 
      RowBox[{"-", "a"}], ",", "a"}], "}"}], ",", 
    RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
    RowBox[{"PlotPoints", "\[Rule]", "50"}], ",", 
